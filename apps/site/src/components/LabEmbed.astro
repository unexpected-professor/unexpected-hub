---
// Embedded interactive laboratory (hub section 7.4).
//
// The lab is first-party (its own subdomain), so unlike the YouTube embed it
// loads directly — no consent gate. It is shown inline at a readable size, not
// full-screen, with two always-visible escape hatches: open in a new tab, and
// full-screen. The lab is cramped on a narrow phone, so below a small width the
// frame is replaced by the buttons alone.
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
---

<figure class="lab" data-lab>
  <figcaption class="lab__bar">
    <span class="lab__label">Laboratoire interactif</span>
    <span class="lab__actions">
      <button type="button" class="lab__btn" data-lab-fullscreen>
        Plein écran
      </button>
      <a class="lab__btn" href={url} target="_blank" rel="noopener">
        Ouvrir dans un nouvel onglet ↗
      </a>
    </span>
  </figcaption>

  <div class="lab__frame-wrap">
    <iframe
      class="lab__frame"
      src={url}
      title={title}
      loading="lazy"
      allow="fullscreen"
    ></iframe>
    <p class="lab__narrow">
      Cet écran est trop étroit pour le laboratoire.
      <a href={url} target="_blank" rel="noopener">Ouvrez-le dans un nouvel
      onglet</a> sur un écran plus large.
    </p>
  </div>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-lab]')) {
    const btn = fig.querySelector('[data-lab-fullscreen]');
    const wrap = fig.querySelector<HTMLElement>('.lab__frame-wrap');
    if (!btn || !wrap) continue;

    if (!wrap.requestFullscreen) {
      btn.setAttribute('hidden', '');
      continue;
    }

    btn.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        wrap.requestFullscreen().catch(() => {
          window.open(
            (fig.querySelector('.lab__frame') as HTMLIFrameElement)?.src,
            '_blank',
            'noopener',
          );
        });
      }
    });
  }
</script>

<style>
  .lab {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .lab__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .lab__label {
    font-weight: 600;
  }

  .lab__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lab__btn {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-accent);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
  }

  .lab__btn:hover {
    border-color: var(--color-accent);
  }

  .lab__frame-wrap {
    position: relative;
    background: var(--color-surface);
  }

  .lab__frame {
    display: block;
    width: 100%;
    height: min(78vh, 680px);
    border: 0;
  }

  .lab__frame-wrap:fullscreen .lab__frame {
    height: 100%;
  }

  .lab__narrow {
    display: none;
    margin: 0;
    padding: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 34rem) {
    .lab__frame {
      display: none;
    }

    .lab__narrow {
      display: block;
    }
  }
</style>
