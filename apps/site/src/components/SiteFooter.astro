---
import { footerNav } from '../nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="Liens légaux">
      <ul>
        {
          footerNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p>
      &copy; {year} The Unexpected Professor. Contenu pédagogique sous licence
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr"
        rel="license"
      >
        CC BY-SA 4.0</a
      >, code sous licence GPL-3.0-only. Vidéos sur
      <a
        href="https://www.youtube.com/@TheUnexpectedProfessor"
        rel="me noopener"
      >
        YouTube</a
      >.
    </p>
  </div>
</footer>

<style>
  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
  }
</style>
